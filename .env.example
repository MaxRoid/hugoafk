# ==========================================
# HugoAFK Configuration
# ==========================================

# Server & Network Ports
PORT=3001
FRONTEND_URL=http://localhost:3000

# SQLite Database Location
DATABASE_PATH=../data/hugoafk.sqlite

# JWT Secret for Session & API Tokens
JWT_SECRET=change_me_to_a_secure_random_key_in_production

# ==========================================
# OAuth 2.0 Providers (Discord & Google)
# ==========================================

# Discord OAuth
# 1. Create an application at https://discord.com/developers/applications
# 2. Add redirect URI: http://localhost:3001/api/auth/discord/callback
# 3. Paste Client ID and Secret below:
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth
# 1. Create credentials at https://console.cloud.google.com/apis/credentials
# 2. Add redirect URI: http://localhost:3001/api/auth/google/callback
# 3. Paste Client ID and Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# Administrator & Owner Permissions
# ==========================================
# Enter your Discord User ID here to automatically receive Owner / Admin rights
# (In Discord: User Settings -> Advanced -> Developer Mode -> Right click your profile -> Copy User ID)
DISCORD_OWNER_ID=

# Optional: Enter your Google / Login Email here for Admin rights
OWNER_EMAIL=

# ==========================================
# SSL / HTTPS Configuration (Optional for Linux / Production)
# ==========================================
# Set SSL_ENABLED=true if running directly with native Node.js SSL certificates
# SSL_ENABLED=false
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_CA_PATH=/etc/letsencrypt/live/yourdomain.com/chain.pem
